# Machine-local state - never sync.
# fish_variables is universal-variable state (per machine), fish_env holds
# local env vars/secrets - config.fish creates it on first run.
.config/fish/fish_variables
.config/fish/fish_env

# chezmoi's own config is generated from .chezmoi.toml.tmpl at init
# (holds per-machine data like git email) - not a static dotfile.
.config/chezmoi/chezmoi.toml

# Repo metadata / OS junk - not a dotfile.
README.md
.DS_Store

# Machine-local ssh stanzas, included by the tracked ~/.ssh/config. Excluded
# from management so per-machine aliases survive that file being reapplied.
.ssh/config.d

{{ if ne .chezmoi.os "linux" }}
# KDE Plasma settings and Handy's kwtype setup - Linux only.
.config/autostart/Handy.desktop
.local/share/com.pais.handy/settings_store.json
.config/dolphinrc
.config/kdeglobals
.config/kglobalshortcutsrc
.config/konsolerc
.config/kwinrulesrc
.config/kxkbrc
.config/mimeapps.list
.config/plasma-localerc
.config/user-dirs.dirs
{{ end }}

{{ if ne .chezmoi.os "darwin" }}
# AeroSpace tiling WM - macOS only.
.config/aerospace
{{ end }}
