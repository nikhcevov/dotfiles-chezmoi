#!/bin/sh
# Rebuild the machine-local cache after applying the custom theme.
# config hash: {{ include "dot_config/bat/config" | sha256sum }}
# theme hash: {{ include "dot_config/bat/themes/tokyonight_moon.tmTheme" | sha256sum }}

if ! command -v bat >/dev/null 2>&1; then
    echo "bat not installed - skipping theme cache setup" >&2
    exit 0
fi

bat cache --build
