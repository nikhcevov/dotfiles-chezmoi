# Managed by chezmoi (dotfiles-chezmoi: private_dot_ssh/private_config).
# Machine-local stanzas belong in ~/.ssh/config.d/*.conf - included FIRST so
# they win (ssh uses the first obtained value), and never tracked, so they
# survive this file being overwritten on every chezmoi apply.
Include ~/.ssh/config.d/*.conf

Host *
  IdentityFile ~/.ssh/id_ed25519
  IdentitiesOnly yes
  ServerAliveInterval 60
  ServerAliveCountMax 3

