#!/bin/sh
# Installs fisher and the plugins from fish_plugins on first apply, and
# re-runs whenever fish_plugins changes (chezmoi watches the hash below).
# Plugin files themselves are NOT managed - fisher owns them.
#
# fish_plugins hash: {{ include "dot_config/fish/fish_plugins" | sha256sum }}

if ! command -v fish >/dev/null 2>&1; then
    echo "fish not installed - skipping fisher setup" >&2
    exit 0
fi

fish <<'FISH_EOF'
if not functions -q fisher
    curl -sL https://raw.githubusercontent.com/jorgebucaran/fisher/main/functions/fisher.fish | source
    and fisher install jorgebucaran/fisher
end
fisher update
FISH_EOF
